# Копирај во .env и пополни. .env НИКОГАШ не се commit-ира.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173
POSTGRES_PASSWORD=travel-dev-password

# AI: "none" = детерминистички избор + OR-Tools (работи без клуч)
#     "anthropic" = LLM избира меѓу кандидатите по ID (серверска валидација)
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_SECONDS=25

# Рутирање: "haversine" (проценка, без мрежа) или "osrm"
ROUTING_PROVIDER=haversine
OSRM_URL=https://router.project-osrm.org

# Временска прогноза: бесплатен клуч од https://openweathermap.org/api
OPENWEATHER_API_KEY=
WEATHER_CACHE_SECONDS=1800

# Гејмификација
CHECKIN_DEFAULT_RADIUS_M=300
MACEDONIA_EXPLORER_MIN_CITIES=3

# --- Продукција (Render + Supabase) — овие се внесуваат во Render, не локално ---
# DATABASE_URL=postgresql://postgres.<ref>:<лозинка>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# SUPABASE_S3_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
# SUPABASE_S3_REGION=eu-central-1
# SUPABASE_S3_ACCESS_KEY_ID=
# SUPABASE_S3_SECRET_ACCESS_KEY=
# SUPABASE_S3_BUCKET=media
# SEED_ADMIN_PASSWORD=
# Frontend (Render static site): VITE_API_URL=https://<backend>.onrender.com
